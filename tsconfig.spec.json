{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/spec",
    "types": [
      "vitest/globals",
      "node"
    ],
    "paths": {
      "@providers/*": [
        "src/app/providers/*"
      ],
      "@pages/*": [
        "src/app/pages/*"
      ],
      "@environments/*": [
        "src/environments/*"
      ],
      "@shared/*": [
        "src/app/shared/*"
      ],
      "@store/*": [
        "src/store/*"
      ],
      "@mocks/*": [
        "mock/*"
      ],
      "@components/*": [
        "src/components/*"
      ],
      "@directives/*": [
        "src/directives/*"
      ],
      "@assets/*": [
        "src/assets/*"
      ],
      "@app/*": [
        "src/app/*"
      ],
      "@capacitor/*": [
        "mock/@capacitor/*"
      ],
      "@capacitor-community/*": [
        "mock/@capacitor-community/*"
      ],
      "@capawesome/*": [
        "mock/@capawesome/*"
      ],
      "@dvsa/capacitor-plugin-asam": [
        "mock/@capacitor/asam"
      ],
      "stream": [
        "node_modules/stream-browserify"
      ],
      "buffer": [
        "node_modules/buffer"
      ],
      "@capgo/capacitor-native-biometric": [
        "mock/capacitor-native-biometric"
      ]
    }
  },
  "files": [
    "src/test-setup.vitest.ts"
  ],
  "include": [
    "src/**/*.spec.ts",
    "src/**/*.d.ts"
  ]
}
