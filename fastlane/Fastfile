default_platform(:ios)

before_all do
  import_from_git(
    url: "git@github.com:dvsa/dvsa-fastlane-library.git",
    branch: "main",
    path: "fastlane/Fastfile"
  )

  clean(dirs: './certs ./codes')

  s3_path = "#{ENV["UPLOAD_PATH"]}"
  version = get_version_number(xcodeproj: "./ios/App/App.xcodeproj", target: "App")

  if s3_path == 'release'
    s3_path = "release/#{version}"
  elsif s3_path == 'feature'
    s3_path = "#{s3_path}/#{ENV["GH_REF_NAME"]}/#{ENV["RUN_ID"]}"
  elsif s3_path == 'develop'
    s3_path = "#{s3_path}/#{version}/#{ENV["RUN_ID"]}"
  end

  ENV["S3_PATH"] = "#{s3_path}"
  ENV["VERSION"] = "#{version}"
  sh("echo S3_PATH=#{ENV["S3_PATH"]} >> $GITHUB_ENV")

  create_keychain(
    name: ENV["KEYCHAIN_NAME"],
    password: ENV["KEYCHAIN_PASSWORD"],
    unlock: true,
    timeout: 3600
  )

  sync_certs(
    type: "enterprise",
    cert_name: ENV["CERT_NAME"],
    cert_repo: ENV["CERT_REPO_URL"],
    cert_branch: ENV["CERT_REPO_BRANCH"],
    username: ENV["APPLE_USERNAME"],
    keychain_name: ENV["KEYCHAIN_NAME"],
    app_identifier: ENV["APP_IDENTIFIER"],
    keychain_password: ENV["KEYCHAIN_PASSWORD"],
    match_password: ENV["MATCH_PASSWORD"]
  )
end

lane :build_ipa do
  environment = ENV["ENVIRONMENT"]
  commit = last_git_commit[:abbreviated_commit_hash]
  name = environment == "feature" ? "#{ENV['BRANCH']}" : ENV["ENVIRONMENT"]
  file_name = "des-#{ENV["VERSION"]}-#{ENV["RUN_ID"]}-#{commit}"

  sh("echo ARTEFACT_FILENAME=#{file_name} >> $GITHUB_ENV")
  sh("echo INSTALL_URL=#{file_name}.html >> $GITHUB_ENV")

  build_mobile(
    name: "#{name}",
    version: ENV["VERSION"],
    export_method: "enterprise",
    file_name: "#{file_name}.ipa",
    environment: "#{environment}",
    display_name: "DES"
  )

  deploy(
    force: true,
    path: ENV["S3_PATH"],
    html_in_folder: true,
    file_name: "#{file_name}",
    environment: "#{environment}",
    bucket: "des-mobile-artefacts",
    html_file_name: "#{file_name}.html",
    ipa_location: "./fastlane/builds/#{file_name}.ipa",
  )

  generate_qr(
    force: true,
    path: ENV["S3_PATH"],
    bucket: "des-mobile-artefacts",
    file_name: ENV["S3_HTML_OUTPUT_PATH"],
    output_name: "./codes/#{file_name}-qr.png",
    file: "./fastlane/codes/#{file_name}-qr.png"
  )

  sh("aws s3 rm s3://des-mobile-artefacts/#{ENV["S3_PATH"]}#{file_name}.app.dSYM.zip")
end

lane :build_sim do
  environment = ENV["ENVIRONMENT"]
  commit = last_git_commit[:abbreviated_commit_hash]
  name = environment == "feature" ? "#{ENV['BRANCH']}" : ENV["ENVIRONMENT"]
  file_name = "des-#{name}-#{ENV["VERSION"]}-#{commit}"
  sh("echo ARTEFACT_FILENAME=#{file_name} >> $GITHUB_ENV")

  build_simulator(
    force: true,
    path: ENV["S3_PATH"],
    version: ENV["VERSION"],
    environment: "#{environment}",
    bucket: "des-mobile-artefacts",
    file_name: "#{file_name}-app.zip",
  )
end

after_all do
  delete_keychain(name: ENV["KEYCHAIN_NAME"])
  icon_banner_restore()
end
