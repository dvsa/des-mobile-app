default_platform(:ios)

before_all do
  xcversion(version: "16.4")

  sh("env > .env.txt")
  sh("aws s3 cp .env.txt s3://des-mobile-artefacts/#{s3_path}#{file_name}.env.txt")

  import_from_git(
    url: "git@github.com:dvsa/dvsa-fastlane-library.git",
    branch: "main",
    path: "fastlane/Fastfile",
    cache: ".imported"
  )

  clean(dirs: './builds ./simulator ./certs ./codes')

  create_keychain(
    name: ENV["KEYCHAIN_NAME"],
    password: ENV["KEYCHAIN_PASSWORD"],
    unlock: true,
    timeout: 3600
  )

  sync_certs(
    type: "enterprise",
    cert_name: ENV["CERT_NAME"],
    cert_repo: ENV["CERT_REPO_URL"],
    cert_branch: ENV["CERT_REPO_BRANCH"],
    username: ENV["APPLE_USERNAME"],
    keychain_name: ENV["KEYCHAIN_NAME"],
    app_identifier: ENV["APP_IDENTIFIER"],
    keychain_password: ENV["KEYCHAIN_PASSWORD"],
    match_password: ENV["MATCH_PASSWORD"]
  )
end

lane :build_ipa do
  version = get_version_number(xcodeproj: "./ios/App/App.xcodeproj", target: "App")
  environment = ENV["ENVIRONMENT"]
  s3_path = "#{ENV["UPLOAD_PATH"]}/#{version}/"

  commit = last_git_commit[:abbreviated_commit_hash]
  name = environment == "feature" ? "#{ENV['BRANCH']}" : ENV["ENVIRONMENT"]
  file_name = "DrivingExaminerService-#{version}-#{ENV["RUN_ID"]}-#{commit}"

  increment_build_number(
    build_number: "#{commit}",
    xcodeproj: "./ios/App/App.xcodeproj",
  )

  build_mobile(
    name: "#{name}",
    version: "#{version}",
    export_method: "enterprise",
    file_name: "#{file_name}.ipa",
    environment: "#{environment}",
    display_name: "DES"
  )

  deploy(
    force: true,
    path: "#{s3_path}",
    html_in_folder: true,
    file_name: "#{file_name}",
    environment: "#{environment}",
    bucket: "des-mobile-artefacts",
    html_file_name: "#{file_name}.html",
    ipa_location: "./fastlane/builds/#{file_name}.ipa",
  )

  generate_qr(
    force: true,
    path: "#{s3_path}",
    bucket: "des-mobile-artefacts",
    file_name: ENV["S3_HTML_OUTPUT_PATH"],
    output_name: "./codes/#{file_name}-qr.png",
    file: "./fastlane/codes/#{file_name}-qr.png"
  )

  sh("aws s3 rm s3://des-mobile-artefacts/#{s3_path}#{file_name}.app.dSYM.zip")
end

lane :build_sim do
  version = get_version_number(xcodeproj: "./ios/App/App.xcodeproj", target: "App")
  environment = ENV["ENVIRONMENT"]
  s3_path = "#{ENV["UPLOAD_PATH"]}/#{version}/"
  commit = last_git_commit[:abbreviated_commit_hash]
  name = environment == "feature" ? "#{ENV['BRANCH']}" : ENV["ENVIRONMENT"]
  file_name = "DrivingExaminerService-#{name}-#{version}-#{commit}"

  increment_build_number(
    build_number: "#{commit}",
    xcodeproj: "./ios/App/App.xcodeproj",
  )

  build_simulator(
    force: true,
    path: "#{s3_path}",
    version: "#{version}",
    environment: "#{environment}",
    bucket: "des-mobile-artefacts",
    file_name: "#{file_name}-app.zip",
  )
end

after_all do
  delete_keychain(name: ENV["KEYCHAIN_NAME"])
  icon_banner_restore()
end
