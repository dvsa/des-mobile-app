readonly(true)
type("appstore")
storage_mode("git")
output_path("./fastlane/certs")
clone_branch_directly(true)
git_url(ENV["FASTLANE_CONFIG_CERT_REPO_URL"])
git_branch(ENV["FASTLANE_CONFIG_CERT_REPO_BRANCH"])

team_id(ENV["FASTLANE_CONFIG_TEAM_ID"])
username(ENV["FASTLANE_CONFIG_APPLE_USERNAME"])
app_identifier(ENV["FASTLANE_CONFIG_APP_IDENTIFIER"])

keychain_name(ENV["FASTLANE_CONFIG_KEYCHAIN_NAME"])
keychain_password(ENV["FASTLANE_CONFIG_KEYCHAIN_PASSWORD"])
